# CMakeLists.txt for Abstract Application Manager
cmake_minimum_required(VERSION 3.16)

project(AbstractAppManager VERSION 1.0 LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_AUTOMOC ON)

# Find required Qt components
find_package(Qt6 6.2 REQUIRED COMPONENTS 
    Core 
    Quick 
    Network 
    Concurrent
)

# Library target for the abstract framework
add_library(AppManagerFramework STATIC
    # Core interfaces
    src/core/applicationmanager.h
    src/core/applicationmanager.cpp
    src/core/interfaces.h
    
    # Concrete implementations
    src/implementations/k8sdockerinstaller.h
    src/implementations/k8sdockerinstaller.cpp
    src/implementations/k8sdockerruntime.h
    src/implementations/k8sdockerruntime.cpp
    src/implementations/httpmarketplacerepository.h
    src/implementations/httpmarketplacerepository.cpp
    src/implementations/jsonconfigurationprovider.h
    src/implementations/jsonconfigurationprovider.cpp
    
    # Factory and plugin system
    src/factory/appmanagerfactory.h
    src/factory/appmanagerfactory.cpp
    src/plugins/pluginmanager.h
    src/plugins/pluginmanager.cpp
    
    # Models for QML
    src/models/applistmodel.h
    src/models/applistmodel.cpp
)

target_link_libraries(AppManagerFramework
    Qt6::Core
    Qt6::Network
    Qt6::Concurrent
)

target_include_directories(AppManagerFramework PUBLIC
    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/src>
    $<INSTALL_INTERFACE:include>
)

# QML module for the framework
qt6_add_qml_module(AppManagerFramework
    URI AppManager
    VERSION 1.0
    SOURCES
        src/core/applicationmanager.h
        src/core/applicationmanager.cpp
        src/models/applistmodel.h
        src/models/applistmodel.cpp
    QML_FILES
        qml/AppManagerView.qml
        qml/MarketplaceView.qml
        qml/InstalledAppsView.qml
        qml/AppCard.qml
        qml/InstalledAppCard.qml
)

# Example application using the framework
add_executable(AppManagerExample
    examples/main.cpp
)

qt6_add_qml_module(AppManagerExample
    URI AppManagerExample
    VERSION 1.0
    QML_FILES
        examples/main.qml
        examples/CustomAppCard.qml
)

target_link_libraries(AppManagerExample
    Qt6::Core
    Qt6::Quick
    AppManagerFramework
)

