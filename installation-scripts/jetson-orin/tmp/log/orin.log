    Port:          <none>
    Host Port:     <none>
    Command:
      /bin/sh
    Args:
      -c
      echo "Starting VSS sync service (offline mode)..."
      
      sync_file() {
        if [ -f /shared/vss.json ]; then
          # Simple file comparison without external tools
          if ! cmp -s /shared/vss.json /persistent/vss.json 2>/dev/null; then
            echo "$(date): VSS file changed, syncing to persistent storage"
            cp /shared/vss.json /persistent/vss.json
            sync  # Force filesystem sync
            echo "$(date): Sync completed"
          fi
        fi
      }
      
      # Initial sync
      sync_file
      
      # Continuous monitoring with longer intervals for offline efficiency
      while true; do
        sync_file
        sleep 10  # Check every 10 seconds (adjust as needed)
      done
      
